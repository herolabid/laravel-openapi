{
    "name": "herolabid/laravel-openapi",
    "description": "Modern Laravel OpenAPI 3.1 specification generator with smart caching and dual UI support (Swagger UI + ReDoc)",
    "keywords": [
        "laravel",
        "openapi",
        "swagger",
        "api-documentation",
        "php8",
        "attributes"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Irfan Arsyad",
            "email": "irfan26arsyad@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0",
        "illuminate/http": "^11.0",
        "illuminate/routing": "^11.0",
        "illuminate/console": "^11.0",
        "symfony/finder": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "HerolabID\\LaravelOpenApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HerolabID\\LaravelOpenApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse src --level=8",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "HerolabID\\LaravelOpenApi\\LaravelOpenApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
